# Copy to .env and adjust.

# --- Project --------------------------------------------------------------
PROJECT_NAME=my-site
APP_FQDN=local.my-site.com

# Vite (change if you run several stacks at once)
# VITE_PORT=5173

# --- WordPress first start ------------------------------------------------
# If wp-load.php is missing, the entrypoint downloads this zip
# and extracts it without overwriting existing files.
WP_VERSION=latest
# WP_VERSION=6.8.2
# SKIP_WP_DOWNLOAD=1

# --- Shared theme (leave unset for a full site in this directory) ---------
# THEME_PATH is the parent folder, not the theme folder.
# From WP-core/<site>/ use ../../WP-themes (not ../WP-themes).
# THEME_NAME=my-theme
# THEME_PATH=../../WP-themes

# Parent folder for local plugin repos. Uncomment the matching /local-plugins
# mounts in docker-compose.yml for each plugin you develop.
# PLUGIN_PATH=../../WP-plugins

# Switch sites by commenting blocks:
# PROJECT_NAME=site-a
# THEME_NAME=theme-a
# THEME_PATH=../../WP-themes
# APP_FQDN=local.site-a.com

# PROJECT_NAME=site-b
# THEME_NAME=theme-b
# THEME_PATH=../../WP-themes
# APP_FQDN=local.site-b.com

# --- Xdebug (rebuild after changing INSTALL_XDEBUG) -----------------------
INSTALL_XDEBUG=false
XDEBUG_MODE=off
# INSTALL_XDEBUG=true
# XDEBUG_MODE=develop,debug

# --- Git inside the container (optional) ----------------------------------
# GIT_USER_NAME=
# GIT_USER_EMAIL=

# --- Search-replace helper (scripts/search-replace-db.sh) -----------------
# PROD_DOMAIN=example.com
# LOCAL_DOMAIN=local.my-site.com
# ADMIN_EMAIL=your.email@example.com
